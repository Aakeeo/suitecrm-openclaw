# ─── Host ports ─────────────────────────────────────────────────────
# Default 8080/8443 avoids collisions with anything already bound to 80/443.
# Change to 80/443 if you're running this on a real domain with no other webserver.
HTTP_PORT=8080
HTTPS_PORT=8443
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790

# ─── SuiteCRM site URL (what the CRM thinks its own URL is) ─────────
# Must match HTTP_PORT above.
SITE_URL=http://localhost:8080

# ─── SuiteCRM admin (also used by OpenClaw for password-grant auth) ─
# Use alphanumerics only — SuiteCRM's API chokes on ! & = in passwords.
ADMIN_USER=admin
ADMIN_PASS=admin123

# ─── Database ───────────────────────────────────────────────────────
DB_NAME=suitecrm
DB_USER=suitecrm
DB_PASS=suitecrm_db_pass
MYSQL_ROOT_PASSWORD=suitecrm_root_2024

# ─── OAuth2 client seeded for OpenClaw ──────────────────────────────
# These are inserted into SuiteCRM's oauth2clients table on first boot.
# The skill at openclaw/skills/suitecrm/ uses them to authenticate.
# Generate a fresh secret before going to production: openssl rand -hex 32
OAUTH2_CLIENT_ID=3c6c6b6a-4c6c-4b6a-8c6c-3b6a4c6c4b6a
OAUTH2_CLIENT_SECRET=change-me-openssl-rand-hex-32

# ─── OpenClaw ───────────────────────────────────────────────────────
# Generate once: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=change-me-to-a-random-hex-string
# Bind mode: "loopback" (host-only), "lan" (reachable from LAN), "all"
OPENCLAW_GATEWAY_BIND=lan
OPENCLAW_TZ=UTC

# Optional: session keys for Claude web backend (leave empty if unused)
CLAUDE_AI_SESSION_KEY=
